{
  "name": "flow-music-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server (Streamable HTTP on 127.0.0.1) that drives Google Flow Music in a dedicated Chrome profile: compose songs, wait for them, download MP3/WAV/M4A",
  "type": "module",
  "main": "./dist/index.js",
  "bin": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "yarn@4.13.0"
}
