# flow-music-mcp settings. Copy this file to .env (in this folder) or to %USERPROFILE%\.flow-music-mcp\.env and fill in
# what you need. .env is never committed. A real environment variable wins over the file; restart the server after an edit.

# Google AI Studio key for the Gemini voices (flow_narrate engine "gemini"). Free tier is enough.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Flow asks "Rights to use this image" (Cancel / I agree) before it takes a local file you upload, for example a first
# frame or a reference picture. Writing exactly "agree" here is YOUR standing declaration that you have the rights to
# the files you give this tool; it then clicks "I agree" for them. Leave it empty and such uploads are cancelled.
# Only you should set this; the tools never set it.
FLOW_MUSIC_MCP_UPLOAD_RIGHTS=

# Spending cap for one paid Flow call (a video scene, continuation, video edit or Flow-voice take) when the request
# gives none. Flow's live quote is checked against it before anything starts; above it, nothing is made.
# Omni 1.1 Flash 360p 4 s = 4 credits, 720p 8 s x2 = 24. Images are free and not affected. Default 50.
FLOW_MUSIC_MCP_MAX_CREDITS=50

# Optional: Gemini text-to-speech model
# FLOW_MUSIC_MCP_GEMINI_TTS=gemini-2.5-flash-preview-tts

# Optional: MCP server
# FLOW_MUSIC_MCP_PORT=7462
# FLOW_MUSIC_MCP_TOKEN=

# Optional: Chrome (the tool's own profile and DevTools port)
# FLOW_MUSIC_MCP_HOME=C:\Users\you\.flow-music-mcp
# FLOW_MUSIC_MCP_CDP_PORT=9334
# FLOW_MUSIC_MCP_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: pause between generations, seconds
# FLOW_MUSIC_MCP_PAUSE_MIN_S=20
# FLOW_MUSIC_MCP_PAUSE_MAX_S=45

# Optional: speech tools (whisper.cpp and its models install themselves into FLOW_MUSIC_MCP_HOME on first use)
# FLOW_MUSIC_MCP_WHISPER=C:\path\to\whisper-cli.exe
# FLOW_MUSIC_MCP_WHISPER_MODEL=C:\path\to\ggml-base.en.bin
# FLOW_MUSIC_MCP_WHISPER_MODELS=C:\more\models;D:\other\models
# FLOW_MUSIC_MCP_FFMPEG=ffmpeg
# FLOW_MUSIC_MCP_FFPROBE=ffprobe
